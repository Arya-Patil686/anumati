# Copy to .env and adjust. Never commit .env.

# --- Service ---
ANUMATI_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./anumati.db

# --- Ledger signing (Ed25519) ---
# Hex-encoded 32-byte Ed25519 seed. Leave blank in dev and a dev key is generated
# into keys/ledger_ed25519.key on first run. Set explicitly in anything shared.
LEDGER_SIGNING_KEY_HEX=

# --- Mandate signing (ES256 / JWS) ---
# PEM path for the ES256 key used to sign IntentMandates. Generated in dev if absent. [M2]
MANDATE_KEY_PATH=keys/mandate_es256.pem

# --- LLM ---
# live   = call the provider and do not cache
# record = call the provider and write every response to the cache
# replay = never touch the network; read from the cache only
LLM_MODE=replay
LLM_CACHE_PATH=data/llm_cache.sqlite
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_ID=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_TIMEOUT_S=30

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- Catalogue ingest [M2] ---
CATALOGUE_CSV_PATH=data/raw/bigbasket_products.csv
CATALOGUE_PARQUET_PATH=data/catalogue/catalogue.parquet

# --- Engine thresholds (tuned on dev, then frozen) [M3] ---
T_VIOLATE=0.70
T_CONFORM=0.70
